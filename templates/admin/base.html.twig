<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %} · Admin {{ APP_NOM_OF }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    {{ importmap('admin') }}
</head>
<body class="adm">

{# Le gabarit de connexion remplace toute la coquille. #}
{% block coquille %}
    <div class="adm-coquille">

        <aside class="adm-barre">
            <a href="{{ path('app_admin_requete') }}" class="adm-barre__marque">
                <img src="{{ asset('images/logo-algorythme-formation.svg') }}"
                     alt="{{ APP_NOM_OF }}" width="1300" height="430">
                <span>Admin</span>
            </a>

            <nav class="adm-barre__nav" aria-label="Navigation de l'admin">
                <a href="{{ path('app_admin_requete') }}"
                   {{ app.current_route == 'app_admin_requete' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
                    </svg>
                    Requêtes
                </a>
                <a href="{{ path('app_admin_formation') }}"
                   {{ app.current_route starts with 'app_admin_formation' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2z"/><path d="M4 20a2 2 0 0 0 2 2h13v-4"/>
                    </svg>
                    Formations
                </a>
                <a href="{{ path('app_admin_domaine') }}"
                   {{ app.current_route starts with 'app_admin_domaine' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
                    </svg>
                    Domaines
                </a>
                <a href="{{ path('app_admin_session') }}"
                   {{ app.current_route starts with 'app_admin_session' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
                    </svg>
                    Sessions
                </a>
                <a href="{{ path('app_admin_formateur') }}"
                   {{ app.current_route starts with 'app_admin_formateur' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
                    </svg>
                    Formateurs
                </a>
                <a href="{{ path('app_admin_client') }}"
                   {{ app.current_route starts with 'app_admin_client' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 9h4a1 1 0 0 1 1 1v11M2 21h20M8 8h3M8 12h3M8 16h3"/>
                    </svg>
                    Clients
                </a>
                <a href="{{ path('app_admin_participant') }}"
                   {{ app.current_route starts with 'app_admin_participant' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.5"/><path d="M2 21a7 7 0 0 1 14 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a7 7 0 0 1 4 6.5"/>
                    </svg>
                    Participants
                </a>
                <a href="{{ path('app_admin_organisme') }}"
                   {{ app.current_route starts with 'app_admin_organisme' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6M9 10h.01M15 10h.01"/>
                    </svg>
                    Organisme
                </a>
                <a href="{{ path('app_admin_indicateur') }}"
                   {{ app.current_route starts with 'app_admin_indicateur' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
                    </svg>
                    Indicateurs
                </a>
            </nav>

            <div class="adm-barre__pied">
                <a href="{{ path('home') }}" class="adm-barre__site">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
                    </svg>
                    Voir le site
                </a>
                <div class="adm-barre__compte">
                    <span class="adm-barre__email">{{ app.user.userIdentifier }}</span>
                    <a href="{{ logout_path() }}">Se déconnecter</a>
                </div>
            </div>
        </aside>

        <main class="adm-principal">
            <header class="adm-entete">
                <div>
                    <h1>{% block titre_page %}{% endblock %}</h1>
                    {% block sous_titre %}{% endblock %}
                </div>
                <div class="adm-entete__actions">{% block actions %}{% endblock %}</div>
            </header>

            {% for message in app.flashes('erreur') %}
                <p class="adm-alerte" role="alert">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('succes') %}
                <p class="adm-alerte adm-alerte--succes" role="status">{{ message }}</p>
            {% endfor %}

            {% block contenu %}{% endblock %}
        </main>

    </div>
{% endblock %}

</body>
</html>
