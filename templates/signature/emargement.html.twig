{% extends 'signature/base.html.twig' %}

{% set jours = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'] %}
{% set nom = formateur ? formateur.libelle : personne %}

{% block title %}Émargement{% endblock %}

{% block contenu %}

    {% if espace %}
        <p><a href="{{ espace }}">← {{ formateur ? 'Mes sessions' : 'Mes formations' }}</a></p>
    {% endif %}

    <section class="adm-carte">
        <div class="adm-carte__corps">
            <p class="adm-signer__sur-titre">Feuille de présence · session {{ session.reference }}</p>
            <h1 class="adm-signer__titre">{{ session.formation.nom }}</h1>
            <p class="adm-signer__qui">
                {{ nom }}{{ formateur ? ', formateur' }}
            </p>
        </div>
    </section>

    {% if inscriptionAnnulee %}
        <p class="adm-alerte" role="alert">Votre inscription à cette session a été annulée.</p>
    {% endif %}

    {% if aSigner %}
        <section class="adm-carte">
            <header class="adm-carte__tete"><h2>Signer ma présence</h2></header>
            <form method="post" class="adm-carte__corps adm-form" data-turbo="false"
                  data-controller="signature" data-action="submit->signature#envoyer">

                {% if erreur %}
                    <p class="adm-alerte" role="alert">{{ erreur }}</p>
                {% endif %}

                <p class="adm-signer__seance">
                    {{ jours[aSigner.jour|date('w')] }} {{ aSigner.jour|date('d/m/Y') }},
                    de {{ aSigner.debut|date('H:i') }} à {{ aSigner.fin|date('H:i') }}
                </p>
                <input type="hidden" name="seance" value="{{ aSigner.id }}">

                <div>
                    <canvas class="adm-signature" data-signature-target="cadre"
                            aria-label="Cadre de signature : signez au doigt ou à la souris"></canvas>
                    <p class="adm-champ__aide">Signez dans le cadre, au doigt ou à la souris.</p>
                    <p class="adm-champ__erreur" role="alert" data-signature-target="erreur" hidden>
                        Signez dans le cadre avant de valider.
                    </p>
                </div>
                <input type="hidden" name="signature" data-signature-target="champ">

                <div class="adm-signer__actions">
                    <button type="button" class="adm-bouton adm-bouton--discret" data-action="signature#effacer">
                        Effacer
                    </button>
                    <button type="submit" class="adm-bouton adm-bouton--principal">Je signe ma présence</button>
                </div>

                <p class="adm-champ__aide">
                    Votre signature, la date, l'heure et l'adresse de votre connexion sont conservées
                    comme preuve de présence.
                </p>
            </form>
        </section>
    {% endif %}

    {% if questionnaires %}
        <section class="adm-carte">
            <header class="adm-carte__tete"><h2>{{ formateur ? 'Évaluation et bilan' : 'Questionnaires' }}</h2></header>
            <ul class="adm-liens">
                {% for ligne in questionnaires %}
                    <li>
                        <strong>
                            {{ ligne.titre }}
                            {% if ligne.detail %}<span class="adm-questionnaire__detail">{{ ligne.detail }}</span>{% endif %}
                        </strong>
                        {% if ligne.etat == 'rempli' %}
                            <a href="{{ ligne.lien }}" class="adm-etiquette adm-etiquette--terminee">
                                {{ formateur and ligne.bouton is not defined ? 'Fait · revoir' : 'Répondu · revoir' }}
                            </a>
                        {% elseif ligne.etat == 'ouvert' %}
                            <a href="{{ ligne.lien }}" class="adm-bouton adm-bouton--principal">
                                {{ ligne.bouton ?? (formateur ? 'Évaluer' : 'Répondre') }}
                            </a>
                        {% elseif ligne.ouvreLe %}
                            <span>Ouvre le {{ ligne.ouvreLe|date('d/m/Y') }}</span>
                        {% else %}
                            <span>Ouvre en fin de formation</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="adm-carte">
        <header class="adm-carte__tete"><h2>Séances</h2></header>
        <ul class="adm-liens">
            {% for ligne in seances %}
                <li>
                    <strong>
                        {{ jours[ligne.seance.jour|date('w')] }} {{ ligne.seance.jour|date('d/m/Y') }},
                        {{ ligne.seance.debut|date('H:i') }} – {{ ligne.seance.fin|date('H:i') }}
                    </strong>
                    {% if ligne.emargement and ligne.emargement.estPresent %}
                        <span class="adm-etiquette adm-etiquette--terminee">
                            Présence enregistrée{{ ligne.emargement.estEnLigne ? ' le ' ~ ligne.emargement.horodatage|date('d/m à H:i', 'Europe/Paris') }}
                        </span>
                    {% elseif ligne.emargement %}
                        <span class="adm-etiquette adm-etiquette--annulee">Absence notée</span>
                    {% elseif ligne.ouverte %}
                        <span class="adm-etiquette adm-etiquette--projet">À signer</span>
                    {% else %}
                        <span>Ouvre à {{ ligne.seance.debut|date('H:i') }} le {{ ligne.seance.jour|date('d/m') }}</span>
                    {% endif %}
                </li>
            {% else %}
                <li><span>Les dates de cette session ne sont pas encore fixées.</span></li>
            {% endfor %}
        </ul>
    </section>

{% endblock %}
