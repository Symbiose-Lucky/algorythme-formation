{% extends 'base.html.twig' %}

{% block title %}{{ formation.nom }} - {{ APP_NOM_OF }}{% endblock %}

{# Même phrase pour la description de la page et les données structurées. #}
{% set description = formation.accroche ?: formation.nom ~ " : formation intra-entreprise " ~ formation.duree ~ ", conduite dans vos locaux ou en classe virtuelle." %}

{% block meta_description %}{{ description }}{% endblock %}

{# Données structurées : la formation (schéma Course) et le fil d'ariane.
   La durée en jours devient une durée ISO 8601 (P2D) quand elle tombe sur des journées entières. #}
{% block head_extra %}
    {% set urlFiche = APP_URL ~ path('app_formation_voir', { slug: formation.slug }) %}
    {% set jours = formation.dureeJours ? formation.dureeJours|split(' ')|first : '' %}
    {% set instance = { '@type': 'CourseInstance', courseMode: ['Onsite', 'Online'] } %}
    {% if jours matches '/^\\d+$/' %}
        {% set instance = instance|merge({ courseWorkload: 'P' ~ jours ~ 'D' }) %}
    {% endif %}
    {% set cours = {
        '@type': 'Course',
        name: formation.nom,
        description: description,
        url: urlFiche,
        inLanguage: 'fr',
        provider: { '@type': 'EducationalOrganization', '@id': APP_URL ~ '/#organisation', name: APP_NOM_OF },
        hasCourseInstance: [instance],
    } %}
    {% if formation.tarifSessionHT %}
        {% set cours = cours|merge({ offers: {
            '@type': 'Offer',
            category: 'Paid',
            price: formation.tarifSessionHT,
            priceCurrency: 'EUR',
            availability: 'https://schema.org/InStock',
        } }) %}
    {% endif %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@graph': [
            cours,
            {
                '@type': 'BreadcrumbList',
                itemListElement: [
                    { '@type': 'ListItem', position: 1, name: 'Accueil', item: APP_URL ~ path('home') },
                    { '@type': 'ListItem', position: 2, name: 'Nos formations', item: APP_URL ~ path('app_formation') },
                    { '@type': 'ListItem', position: 3, name: formation.nom, item: urlFiche },
                ],
            },
        ],
    }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/formation.scss') }}">
{% endblock %}

{% block body %}

    {# `formation` vient de l'admin (CatalogueFormations::fiche). Les textes
       communs à toutes les formations (socle, contacts, et les modalités
       laissées vides sur la fiche) sont écrits ici. #}

    {# Le nom public d'une formule de session et ce qu'elle recouvre. La clé
       est la formule du tarif (CatalogueFormations::tarifs). #}
    {% set libelles = {
        inter: {
            nom: 'Inter-entreprises',
            texte: "Vos collaborateurs rejoignent une session à date fixe, aux côtés de participants venus d'autres entreprises."
        },
        intra: {
            nom: 'Intra-entreprise',
            texte: "La formation est dispensée au sein de votre entreprise et réunit vos seuls collaborateurs, dans le cadre d'une session dédiée."
        }
    } %}

    {# Le choix de formule n'a de sens que si la formation a les deux tarifs. #}
    {% set formules = formation.tarifs|filter(tarif => tarif.formule is not null) %}
    {% set choixFormule = formules|length > 1 %}

    <div class="fiche" data-controller="impression">

        <nav class="fo-crumbs af-container" aria-label="Fil d'ariane">
            <ol>
                <li><a href="{{ path('home') }}">Accueil</a></li>
                <li><a href="{{ path('app_formation') }}">Nos formations</a></li>
                <li aria-current="page">{{ formation.nom }}</li>
            </ol>
        </nav>

        {# ------------------------------------------------------- En-tête #}
        <section class="fo-head af-container" data-controller="formule">
            {% if formation.domaine %}
                <span class="fo-domaine">{{ formation.domaine.nom }}</span>
            {% endif %}

            <h1>{{ formation.nom }}</h1>

            {% if formation.accroche %}
                <p class="fo-lede">{{ formation.accroche }}</p>
            {% endif %}

            {{ include('partials/_notation_etoiles.html.twig', {
                note: formation.note,
                nbFormes: formation.nbFormes,
                classe: 'fo-note',
            }) }}

            {# Ce qui ne dépend pas de la formule choisie. #}
            <dl class="fo-meta">
                {% if formation.duree %}
                    <div>
                        <dt>Durée</dt>
                        {# Les journées parlent davantage qu'un volume d'heures :
                           le détail horaire reste dans les modalités. #}
                        <dd>{{ formation.dureeJours ?: formation.duree }}</dd>
                    </div>
                {% endif %}
                <div>
                    <dt>Modalité</dt>
                    {# Modalité et effectif valent pour toutes nos formations :
                       ils sont écrits ici. #}
                    <dd>Présentiel, distanciel ou les deux</dd>
                </div>
                <div>
                    <dt>Effectif</dt>
                    <dd>De 2 à 12 participants</dd>
                </div>
            </dl>

            {# Ce qui en dépend : le tarif et ce que la formule recouvre. #}
            {% if choixFormule %}
                <div class="fo-choix">
                    <fieldset class="fo-choix__champ">
                        <legend class="fo-choix__legende">Formule de session</legend>
                        <div class="fo-choix__options">
                            {% for tarif in formules %}
                                <label class="fo-choix__option">
                                    <input type="radio" name="formule" value="{{ tarif.formule }}"
                                        {{ loop.first ? 'checked' }}
                                           data-action="formule#choisir">
                                    <span>{{ libelles[tarif.formule].nom }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>

                    {% for tarif in formules %}
                        <div class="fo-choix__detail"
                             data-formule-target="panneau" data-formule="{{ tarif.formule }}"
                            {{ loop.first ? '' : 'hidden' }}>
                            <p class="fo-choix__prix">
                                {{ tarif.montantHT|number_format(0, ',', ' ') }} € HT
                                <span>la session</span>
                            </p>
                            <p class="fo-choix__texte">{{ libelles[tarif.formule].texte }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% elseif formation.tarifSessionHT %}
                <div class="fo-choix">
                    <p class="fo-choix__prix">
                        À partir de {{ formation.tarifSessionHT|number_format(0, ',', ' ') }} € HT
                        <span>la session</span>
                    </p>
                </div>
            {% endif %}

            <p class="fo-print-only">
                {{ APP_NOM_OF }} (SAS) - SIRET 101 916 674 00019 - NDA 75331851633 -
                422 Avenue de Verdun, 33700 Mérignac - 05 54 54 24 84 -
                contact@algorythme-formation.fr
            </p>

            <div class="fo-actions">
                <a href="#proposition" class="af-btn af-btn--primary af-btn--lg">Demander une proposition</a>
                <a href="#modalites" class="fo-ancre">Voir les modalités détaillées</a>
            </div>
        </section>

        <div class="af-container">

            <div class="fo-signal-wrap"
                 data-controller="signal"
                 data-signal-disorder-value="1"
                 data-signal-seed-value="17"
                 data-signal-height-value="30"></div>

            {# ---------------------------------------------------- Objectifs #}
            {% set objectifs = formation.objectifs ?: formation.objectifsPedagogiques %}
            {% if objectifs %}
                <section class="fo-bloc" id="objectifs">
                    <h2>Ce que vous saurez faire</h2>
                    <ul class="fo-objectifs">
                        {% for objectif in objectifs %}
                            <li>{{ objectif }}</li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {# ------------------------------------------- Ce que ça change #}
            {% if formation.ceQuiChange %}
                <section class="fo-bloc" id="bascule">
                    <h2>Ce que ça change, concrètement</h2>

                    <div class="fo-signal-wrap fo-signal--bascule"
                         data-controller="signal"
                         data-signal-disorder-value="1"
                         data-signal-seed-value="29"
                         data-signal-height-value="30"></div>

                    <div class="fo-paires">
                        {% for paire in formation.ceQuiChange %}
                            <div class="fo-paire">
                                <p class="fo-paire__tache">{{ paire.tache }}</p>
                                <div class="fo-paire__duo">
                                    <div class="fo-etat fo-etat--avant">
                                        <p class="fo-etat__label">Aujourd'hui</p>
                                        <p>{{ paire.avant }}</p>
                                    </div>
                                    <span class="fo-fleche" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" width="18" height="18">
                                            <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor"
                                                  stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </span>
                                    <div class="fo-etat fo-etat--apres">
                                        <p class="fo-etat__label">Après la formation</p>
                                        <p>{{ paire.apres }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {# ------------------------------------------------------ Déroulé #}
            {% if formation.deroule %}
                <section class="fo-bloc" id="contenu">
                    <h2>Le déroulé</h2>

                    {% for journee in formation.deroule %}
                        {% if journee.titre %}
                            {# Déroulé découpé en journées : une journée par accordéon. #}
                            <details class="fo-jour" {{ loop.first ? 'open' }}>
                                <summary>
                                    {{ journee.titre }}
                                    {% if journee.duree %}
                                        <span class="fo-jour-duree">{{ journee.duree }}</span>
                                    {% endif %}
                                </summary>
                                <div class="fo-demi">
                                    {% for sequence in journee.sequences %}
                                        <div>
                                            <h3>
                                                {% if sequence.duree %}<span>{{ sequence.duree }}</span>{% endif %}
                                                {{ sequence.titre }}
                                            </h3>
                                            {% if sequence.points %}
                                                <ul>
                                                    {% for point in sequence.points %}
                                                        <li>{{ point }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </details>
                        {% else %}
                            {# Déroulé saisi sans journées : une séquence par accordéon. #}
                            {% for sequence in journee.sequences %}
                                <details class="fo-jour" {{ loop.first ? 'open' }}>
                                    <summary>
                                        {{ sequence.titre }}
                                        {% if sequence.duree %}
                                            <span class="fo-jour-duree">{{ sequence.duree }}</span>
                                        {% endif %}
                                    </summary>
                                    {% if sequence.points %}
                                        <div class="fo-demi fo-demi--simple">
                                            <div>
                                                <ul>
                                                    {% for point in sequence.points %}
                                                        <li>{{ point }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    {% endif %}
                                </details>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </section>
            {% endif %}

            {# -------------------------------------------- Socle / déclinaison #}
            <section class="fo-bloc" id="socle">
                <h2>Programme de référence, adapté à votre cahier des charges</h2>
                <div class="fo-socle">
                    <div class="fo-socle__carte fo-socle__carte--socle">
                        <h3>Le socle commun</h3>
                        <ul>
                            <li>Les objectifs pédagogiques</li>
                            <li>La durée et le découpage horaire</li>
                            <li>Les prérequis</li>
                            <li>Les modalités d'évaluation des acquis</li>
                        </ul>
                    </div>
                    <div class="fo-socle__carte fo-socle__carte--vous">
                        <h3>Votre déclinaison</h3>
                        <ul>
                            <li>Les travaux pratiques et les jeux de données</li>
                            <li>L'environnement technique et les outils utilisés</li>
                            <li>L'ordre et la pondération des séquences</li>
                            <li>Les exemples tirés de vos projets</li>
                        </ul>
                    </div>
                </div>
                <p class="fo-socle__note">
                    Le programme définitif est annexé à la convention de formation et constitue
                    le seul document contractuel de référence.
                </p>
            </section>

            {# ------------------------------------------------- Questions #}
            {# Questions communes à toutes les formations : elles portent sur
               notre façon de travailler, pas sur un programme en particulier.
               Elles sont écrites ici. #}
            <section class="fo-bloc" id="questions">
                <h2>Questions fréquentes</h2>

                <div class="fo-faq">
                    <details>
                        <summary>Nos collaborateurs n'ont pas tous le même niveau.</summary>
                        <p>
                            Un test de positionnement est adressé à chaque participant avant l'entrée
                            en formation et le déroulé est ajusté aux niveaux réellement présents.
                            Si l'écart est trop important pour une même session, nous vous le
                            signalons avant l'établissement de la convention.
                        </p>
                    </details>

                    <details>
                        <summary>La formation peut-elle porter sur nos propres outils et projets ?</summary>
                        <p>
                            Oui. Les travaux pratiques portent sur votre environnement technique et
                            sur des cas tirés de vos projets. Les objectifs et la durée, eux, restent
                            ceux du programme de référence.
                        </p>
                    </details>

                    <details>
                        <summary>Cette formation est-elle finançable par notre OPCO ?</summary>
                        <p>
                            Oui, dans les conditions propres à votre branche. {{ APP_NOM_OF }} est
                            certifié Qualiopi au titre de la catégorie d'action « Actions de
                            formation ». Nous constituons les pièces du dossier avec vous.
                        </p>
                    </details>

                    <details>
                        <summary>La formation peut-elle se tenir à distance ?</summary>
                        <p>
                            Oui. Nos formations sont conduites dans vos locaux ou en classe virtuelle,
                            avec partage d'écran et travaux pratiques encadrés. Le choix se fait au
                            moment du cadrage, en fonction de la répartition de vos équipes.
                        </p>
                    </details>

                    <details>
                        <summary>Sous quel délai une session peut-elle démarrer ?</summary>
                        <p>
                            Comptez 5 jours ouvrés pour recevoir la proposition et le programme
                            adaptés, puis 4 à 8 semaines avant l'entrée en formation. Un dossier
                            OPCO demande 3 semaines supplémentaires au minimum.
                        </p>
                    </details>

                    <details>
                        <summary>Un de nos participants est en situation de handicap.</summary>
                        <p>
                            Signalez-le au moment du cadrage : les modalités, les supports et le
                            rythme sont adaptés au cas par cas. Notre référent handicap,
                            Mathieu Piron-Lafleur, étudie chaque situation avec vous
                            (<a href="mailto:contact@algorythme-formation.fr">contact@algorythme-formation.fr</a>).
                        </p>
                    </details>
                </div>
            </section>

        </div>

        {# ----------------------------------------------------- Modalités #}
        <div class="fo-modalites">
            <div class="af-container">
                <section class="fo-bloc" id="modalites">
                    <h2>Modalités et informations pratiques</h2>

                    <dl class="fo-fiche">

                        {% if formation.publicVise %}
                            <div>
                                <dt>Public visé</dt>
                                <dd>{{ include('front/formation/_liste.html.twig', { items: formation.publicVise }) }}</dd>
                            </div>
                        {% endif %}

                        {% if formation.preRequis %}
                            <div>
                                <dt>Prérequis</dt>
                                <dd>{{ include('front/formation/_liste.html.twig', { items: formation.preRequis }) }}</dd>
                            </div>
                        {% endif %}

                        {% if formation.duree %}
                            <div>
                                <dt>Durée et organisation</dt>
                                <dd>
                                    {{- formation.duree }}, en présentiel, en distanciel ou les deux.
                                    De 2 à 12 participants, dans vos locaux ou en classe virtuelle.
                                </dd>
                            </div>
                        {% endif %}

                        {% if formation.methodes %}
                            <div>
                                <dt>Méthodes mobilisées</dt>
                                <dd>{{ include('front/formation/_liste.html.twig', { items: formation.methodes }) }}</dd>
                            </div>
                        {% endif %}

                        {% if formation.moyens %}
                            <div>
                                <dt>Moyens et supports</dt>
                                <dd>{{ include('front/formation/_liste.html.twig', { items: formation.moyens }) }}</dd>
                            </div>
                        {% endif %}

                        {% if formation.profilFormateurs %}
                            <div>
                                <dt>Profil des formateurs</dt>
                                <dd>{{ include('front/formation/_liste.html.twig', { items: formation.profilFormateurs }) }}</dd>
                            </div>
                        {% endif %}

                        <div>
                            <dt>Évaluation et suivi</dt>
                            <dd>
                                {% if formation.evaluation %}
                                    {{ include('front/formation/_liste.html.twig', { items: formation.evaluation }) }}
                                {% else %}
                                    {# Processus commun à toutes nos actions de formation. #}
                                    <ul>
                                        <li>À l'entrée : analyse du besoin, test de positionnement, auto-évaluation</li>
                                        <li>En cours : exercice validé à chaque séquence, point d'étape à mi-parcours
                                        </li>
                                        <li>En fin : mise en situation, auto-évaluation de sortie, certificat de
                                            réalisation
                                        </li>
                                        <li>À distance : satisfaction à chaud, questionnaire à froid à 90 jours, bilan
                                            au commanditaire
                                        </li>
                                    </ul>
                                {% endif %}
                            </dd>
                        </div>

                        <div>
                            <dt>Modalités et délais d'accès</dt>
                            <dd>
                                {% if formation.acces %}
                                    {{ include('front/formation/_liste.html.twig', { items: formation.acces }) }}
                                {% else %}
                                    Prise de contact, puis entretien d'analyse du besoin de 30 minutes.
                                    <br>Proposition et programme adaptés sous 5 jours ouvrés.
                                    <br>Entrée en
                                    formation sous 4 à 8 semaines après signature de la convention,
                                    et 3 semaines supplémentaires minimum en cas de dossier OPCO.
                                {% endif %}
                            </dd>
                        </div>

                        {% if formation.tarifs %}
                            <div class="fo-fiche__large">
                                <dt>Tarif</dt>
                                <dd>
                                    {# Une carte par formule de session (inter, intra) ; les textes
                                       qui l'expliquent sont écrits ici. #}
                                    <ul class="fo-formules">
                                        {% for tarif in formation.tarifs %}
                                            <li class="fo-formule">
                                                <p class="fo-formule__nom">
                                                    {{ libelles[tarif.formule].nom|default(tarif.intitule ?: 'Session dédiée') }}
                                                </p>
                                                <p class="fo-formule__prix">
                                                    {{ tarif.montantHT|number_format(0, ',', ' ') }} € HT
                                                    <span>la session</span>
                                                </p>
                                                <p class="fo-formule__texte">
                                                    {{ libelles[tarif.formule].texte|default('Session dédiée à votre entreprise, dans vos locaux ou en classe virtuelle.') }}
                                                </p>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                    <p class="fo-formules__note">
                                        Acompte de 50 % à la signature, solde à 30 jours. Frais de déplacement
                                        en sus hors Gironde. Action de formation finançable par votre OPCO.
                                    </p>
                                </dd>
                            </div>
                        {% endif %}

                        <div>
                            <dt>Accessibilité et handicap</dt>
                            <dd>
                                {% if formation.accessibilite %}
                                    {{ include('front/formation/_liste.html.twig', { items: formation.accessibilite }) }}
                                {% else %}
                                    Nos actions de formation sont ouvertes aux personnes en situation de
                                    handicap, avec une adaptation au cas par cas des modalités, des supports
                                    et du rythme.
                                {% endif %}
                                <br>Référent handicap : Mathieu Piron-Lafleur,
                                <a href="mailto:contact@algorythme-formation.fr">contact@algorythme-formation.fr</a>.
                            </dd>
                        </div>

                        <div>
                            <dt>Contacts</dt>
                            <dd>
                                {{ APP_NOM_OF }},<br>
                                <a href="tel:0554542484">05 54 54 24 84</a><br>
                                <a href="mailto:contact@algorythme-formation.fr">contact@algorythme-formation.fr</a><br><br>
                                Référent pédagogique : Alan Piron-Lafleur. Référent qualité : Mayana Elbaz.
                            </dd>
                        </div>

                    </dl>

                    {% if formation.misAJourLe %}
                        <p class="fo-maj">Programme mis à jour le {{ formation.misAJourLe|date('d/m/Y') }}.</p>
                    {% endif %}
                </section>
            </div>
        </div>

        {# ----------------------------------------------------------- CTA #}
        <section class="fo-cta" id="proposition">
            <div class="af-container fo-cta-in">
                <div class="fo-signal-wrap fo-signal--cta"
                     data-controller="signal"
                     data-signal-disorder-value="0"
                     data-signal-seed-value="17"
                     data-signal-height-value="28"></div>
                <h2>Organiser cette formation dans votre entreprise</h2>
                <p>Trente minutes pour préciser votre besoin.</p>
                <a href="{{ path('home') }}#quiz" class="af-btn af-btn--primary af-btn--lg">
                    Demander une proposition
                </a>
                <p class="fo-cta-joindre mt-3">
                    <a href="tel:0554542484">05 54 54 24 84</a><br>
                    <a href="mailto:contact@algorythme-formation.fr">contact@algorythme-formation.fr</a>
                </p>
            </div>
        </section>

        {# Barre d'action fixe, affichée en mobile uniquement. #}
        <div class="fo-sticky">
            <a href="tel:0554542484" class="af-btn af-btn--secondary">Appeler</a>
            <a href="#proposition" class="af-btn af-btn--primary">Demander une proposition</a>
        </div>

    </div>

{% endblock %}
